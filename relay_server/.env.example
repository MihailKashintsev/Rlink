# Rlink Relay Server — environment variables
# Copy to .env and fill in your values before running docker-compose

# ── Admin panel ───────────────────────────────────────────────────────────
# SHA-256 hex hash of your admin password.
# Generate: echo -n "YourPassword" | shasum -a 256 | awk '{print $1}'
# Generate your own value; do not ship the default development password.
RELAY_ADMIN_HASH=

# ── VAPID (web push notifications) ───────────────────────────────────────
# Generate with: dart run relay_server/bin/generate_vapid_keys.sh
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PEM=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Cloud storage durable linking (OAuth backend) ────────────────────────
# Same relay-held-refresh-token flow for Google Drive, OneDrive and Dropbox.
# The relay holds the secret and refresh token; clients only get short-lived
# access tokens. Leave a provider's ID/SECRET empty to disable it — the
# client can still show the others.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Public https base each provider redirects back to (must match each
# console's registered redirect URI <base>/oauth/<provider>/callback).
OAUTH_REDIRECT_BASE=https://185.244.172.90.nip.io

# ── Rlink Premium (YooKassa) ──────────────────────────────────────────────
# From the YooKassa merchant dashboard. The secret key never leaves the relay —
# clients only ask it to create a payment and to report the result.
# Leave empty to disable purchases (status checks keep working).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Where the payment page sends the user back after paying.
PREMIUM_RETURN_URL=https://rendergames.ru/rlink_premium
# Register this as the notification URL in the YooKassa dashboard:
#   https://<your relay>/premium/webhook   (event payment.succeeded)

# ── Self-hosted TURN (optional) ───────────────────────────────────────────
TURN_HOST=your.turn.server
TURN_USER=turnuser
TURN_PASSWORD=turnpassword
